<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] — Движение</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <div class="container header-inner">
            <a class="brand" asp-controller="Home" asp-action="Index"><span class="brand-mark">Д.</span><span>ДВИЖЕНИЕ</span></a>
            <nav class="main-nav" aria-label="Главное меню">
                <a asp-controller="Catalog" asp-action="Index">Каталог</a>
                @if (User.IsInRole(Roles.Buyer))
                {
                    <a asp-controller="Orders" asp-action="Index">Заказы</a>
                    <a asp-controller="Wallet" asp-action="Index">Карта</a>
                    <a asp-controller="Complaints" asp-action="Index">Жалобы</a>
                }
                @if (User.IsInRole(Roles.Seller))
                {
                    <a asp-controller="Seller" asp-action="Index">Магазин</a>
                    <a asp-controller="Seller" asp-action="Orders">Заказы</a>
                }
                @if (User.IsInRole(Roles.Admin))
                {
                    <a asp-controller="Admin" asp-action="Index">Панель администратора</a>
                }
            </nav>
            <div class="header-actions">
                @if (User.IsInRole(Roles.Buyer))
                {
                    <a class="header-cart" asp-controller="Cart" asp-action="Index" aria-label="Корзина">Корзина <span>↗</span></a>
                }
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <span class="header-user">@User.Identity.Name</span>
                    <form asp-controller="Account" asp-action="Logout" method="post">

                        <button class="link-button" type="submit">Выйти</button>
                    </form>
                }
                else
                {
                    <a class="header-login" asp-controller="Account" asp-action="Login">Войти</a>
                }
            </div>
        </div>
    </header>

    <main>
        @if (TempData["Success"] is string success)
        {
            <div class="container"><div class="notice success" role="status">@success</div></div>
        }
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container footer-inner">
            <div><strong>ДВИЖЕНИЕ</strong><p>Спортивный инвентарь для тех, кто не стоит на месте.</p></div>
            <div><span>Учебный проект</span><p>Оплата виртуальной картой. Реальные деньги не списываются.</p></div>
        </div>
    </footer>
    <script src="~/js/site.js" asp-append-version="true" defer></script>
    <script src="~/js/phone-mask.js" asp-append-version="true" defer></script>
</body>
</html>
