@model Product
@{ ViewData["Title"] = "Удаление товара"; }
<section class="container page-space narrow">
    <div class="breadcrumb"><a asp-action="Products">Товары</a><span>/</span>Удаление</div>
    <div class="page-heading"><div class="eyebrow">УПРАВЛЕНИЕ ТОВАРАМИ</div><h1>Удалить товар<span class="heading-dot">?</span></h1></div>
    <div class="form-panel delete-product-panel">
        @if (Model.ImagePath is not null)
        {
            <img class="photo-preview" src="@Model.ImagePath" alt="@Model.Name" />
        }
        <h2>@Model.Name</h2>
        <p>@Model.Price.ToString("N2") ₽ · В наличии: @Model.Stock шт.</p>
        <p>Товар исчезнет из каталога, списков товаров и корзин покупателей. Оформленные заказы и жалобы останутся в истории.</p>
        <p><strong>Восстановить товар через сайт после удаления нельзя.</strong></p>
        <form asp-action="DeleteProduct" asp-route-id="@Model.Id" method="post" class="product-actions">
            <a class="button button-dark" asp-action="Products">Отмена</a>
            <button class="button button-danger" type="submit">Удалить товар</button>
        </form>
    </div>
</section>
