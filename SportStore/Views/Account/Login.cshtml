@model LoginForm
@{ ViewData["Title"] = "Вход"; }
<section class="container auth-section">
    <div class="auth-side"><div class="eyebrow light">С ВОЗВРАЩЕНИЕМ</div><h1>Продолжай<br /><em>двигаться.</em></h1><p>Все твои покупки, товары и решения — в одном месте.</p></div>
    <div class="auth-card"><div class="eyebrow">ЛИЧНЫЙ КАБИНЕТ</div><h2>Войти</h2><p>Нет аккаунта? <a asp-action="Register">Зарегистрироваться ↗</a></p>
        <form asp-action="Login" asp-route-returnUrl="@ViewBag.ReturnUrl" method="post" class="stack-form">

            <div asp-validation-summary="ModelOnly" class="validation"></div>
            <label asp-for="Login">Логин или email</label><input asp-for="Login" type="text" autocomplete="username" autocapitalize="none" spellcheck="false" placeholder="Например, admin" /><span asp-validation-for="Login" class="validation"></span>
            <label asp-for="Password">Пароль</label><input asp-for="Password" type="password" autocomplete="current-password" /><span asp-validation-for="Password" class="validation"></span>
            <label class="check-row"><input asp-for="RememberMe" /> Запомнить меня</label>
            <button class="button button-dark full" type="submit">Войти ↗</button>
        </form>
    </div>
</section>
