@model List<SellerOrder>
@{ ViewData["Title"] = "Все заказы"; }
<section class="container page-space"><div class="breadcrumb"><a asp-action="Index">Панель администратора</a><span>/</span>Заказы</div><div class="page-heading"><div class="eyebrow">КОНТРОЛЬ ПЛОЩАДКИ</div><h1>Все заказы<span class="heading-dot">.</span></h1><p>Заказы каждого независимого продавца.</p></div>
    @if (Model.Count == 0) { <div class="empty-state"><h2>Заказов пока нет</h2></div> }
    else { <div class="table-wrap"><table><thead><tr><th>Заказ</th><th>Покупатель</th><th>Продавец</th><th>Товары</th><th>Сумма</th><th>Статус</th></tr></thead><tbody>@foreach (var order in Model) { <tr><td><strong>№@order.Id</strong><br />@order.Purchase.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")</td><td>@order.Purchase.Buyer.DisplayName</td><td>@(order.Seller.SellerProfile?.StoreName ?? order.Seller.DisplayName)</td><td>@(string.Join(", ", order.Items.Select(i => $"{i.ProductName} × {i.Quantity}")))</td><td>@order.Total.ToString("N0") ₽</td><td><span class="status">@order.Status</span></td></tr> }</tbody></table></div> }
</section>
