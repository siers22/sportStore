@model List<AppUser>
@{ ViewData["Title"] = "Пользователи"; var roles = ViewBag.Roles as Dictionary<string, string> ?? new Dictionary<string, string>(); }
<section class="container page-space">
    <div class="breadcrumb"><a asp-action="Index">Панель администратора</a><span>/</span>Пользователи</div>
    <div class="page-heading"><div class="eyebrow">МОДЕРАЦИЯ</div><h1>Пользователи<span class="heading-dot">.</span></h1></div>
    @if (TempData["Error"] is string error) { <div class="validation">@error</div> }
    <div class="table-wrap"><table>
        <thead><tr><th>Имя</th><th>Email</th><th>Роль</th><th>Статус и причина</th><th>Действие</th></tr></thead>
        <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td><strong>@user.DisplayName</strong></td>
                <td>@user.Email</td>
                <td>@(roles.GetValueOrDefault(user.Id) ?? "—")</td>
                <td><span class="status">@(user.IsBlocked ? "Заблокирован" : "Активен")</span>
                    @if (user.IsBlocked && !string.IsNullOrWhiteSpace(user.BlockReason)) { <p>Причина: @user.BlockReason</p> }
                </td>
                <td>
                    @if (!roles.GetValueOrDefault(user.Id, "").Contains(Roles.Admin))
                    {
                        if (user.IsBlocked)
                        {
                            <form asp-action="UnblockUser" asp-route-id="@user.Id" method="post"><button class="text-link link-button" type="submit">Разблокировать</button></form>
                        }
                        else
                        {
                            <form asp-action="BlockUser" asp-route-id="@user.Id" method="post">
                                <label for="block-reason-@user.Id">Причина блокировки</label>
                                <textarea id="block-reason-@user.Id" name="reason" rows="2" maxlength="1000" required></textarea>
                                <button class="text-link link-button" type="submit">Заблокировать</button>
                            </form>
                        }
                    }
                </td>
            </tr>
        }
        </tbody>
    </table></div>
</section>
