@model List<Complaint>
@{ ViewData["Title"] = "Жалобы"; }
<section class="container page-space"><div class="breadcrumb"><a asp-action="Index">Панель администратора</a><span>/</span>Жалобы</div><div class="page-heading"><div class="eyebrow">МОДЕРАЦИЯ</div><h1>Жалобы<span class="heading-dot">.</span></h1><p>Изучите проблему и оставьте решение для покупателя.</p></div>
    @if (TempData["Error"] is string error) { <div class="validation">@error</div> }
    @if (Model.Count == 0) { <div class="empty-state"><h2>Жалоб пока нет</h2></div> }
    else { <div class="complaint-list">@foreach (var complaint in Model) { <article class="complaint-card"><div class="row-between"><div><small>ЖАЛОБА №@complaint.Id · @complaint.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy") · @complaint.Buyer.DisplayName</small><h2>@complaint.Product.Name</h2></div><span class="status">@StatusText(complaint.Status)</span></div><p>@complaint.Reason</p><form asp-action="ReviewComplaint" asp-route-id="@complaint.Id" method="post" class="review-form"><label>Комментарий администратора<textarea name="comment" rows="3" maxlength="1000">@complaint.AdminComment</textarea></label><label>Статус<select name="status"><option value="InReview" selected="@(complaint.Status == ComplaintStatus.InReview)">На рассмотрении</option><option value="Closed" selected="@(complaint.Status == ComplaintStatus.Closed)">Закрыта</option></select></label><label class="check-row"><input type="checkbox" name="hideProduct" value="true" /> Скрыть товар из каталога (комментарий станет причиной для продавца)</label><button class="button button-dark" type="submit">Сохранить решение ↗</button></form></article> }</div> }
</section>
@functions { string StatusText(ComplaintStatus status) => status switch { ComplaintStatus.New => "Новая", ComplaintStatus.InReview => "На рассмотрении", _ => "Закрыта" }; }
