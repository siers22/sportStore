@model List<Complaint>
@{ ViewData["Title"] = "Панель администратора"; }
<section class="container page-space"><div class="dashboard-header"><div><div class="eyebrow">УПРАВЛЕНИЕ ПЛОЩАДКОЙ</div><h1>Администратор<span class="heading-dot">.</span></h1><p>Пользователи, товары и жалобы под контролем.</p></div></div>
    <div class="stats-grid four"><div class="stat-card"><span>ПОЛЬЗОВАТЕЛИ</span><strong>@ViewBag.UserCount</strong><a asp-action="Users">Открыть ↗</a></div><div class="stat-card"><span>ТОВАРЫ</span><strong>@ViewBag.ProductCount</strong><a asp-action="Products">Проверить ↗</a></div><div class="stat-card"><span>ЗАКАЗЫ</span><strong>@ViewBag.OrderCount</strong><a asp-action="Orders">Посмотреть ↗</a></div><div class="stat-card dark"><span>ОТКРЫТЫЕ ЖАЛОБЫ</span><strong>@ViewBag.OpenComplaints</strong><a asp-action="Complaints">Рассмотреть ↗</a></div></div>
    <div class="section-heading"><div><div class="eyebrow">ОБРАТНАЯ СВЯЗЬ</div><h2>Последние жалобы</h2></div><a class="text-link" asp-action="Complaints">Все жалобы ↗</a></div>
    @if (Model.Count == 0) { <div class="empty-state"><h2>Жалоб пока нет</h2></div> }
    else { <div class="list-panel">@foreach (var complaint in Model) { <div class="list-row"><div><small>ЖАЛОБА №@complaint.Id · @complaint.Buyer.DisplayName</small><strong>@complaint.Product.Name</strong></div><span>@complaint.Status</span><a asp-action="Complaints">↗</a></div> }</div> }
</section>
