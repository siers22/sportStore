@model List<Product>
@{ ViewData["Title"] = "Мои товары"; }
<section class="container page-space"><div class="dashboard-header"><div><div class="eyebrow">МОЙ МАГАЗИН</div><h1>Мои товары<span class="heading-dot">.</span></h1><p>Изменяйте цены, остатки и публикацию товаров.</p></div><a class="button button-accent" asp-action="CreateProduct">Добавить товар ↗</a></div>
    @if (Model.Count == 0) { <div class="empty-state"><h2>Пока нет товаров</h2><a class="button button-dark" asp-action="CreateProduct">Добавить первый товар</a></div> }
    else { <div class="table-wrap"><table><thead><tr><th>Товар</th><th>Категория</th><th>Цена</th><th>Остаток</th><th>Статус и причина</th><th></th></tr></thead><tbody>@foreach (var product in Model) { <tr><td><strong>@product.Name</strong></td><td>@product.Category.Name</td><td>@product.Price.ToString("N0") ₽</td><td>@product.Stock</td><td><span class="status">@(product.ModerationStatus switch { ProductModerationStatus.PendingReview => "На проверке у администратора", ProductModerationStatus.ChangesRequested => "Нужны исправления", _ => product.IsPublished ? "Опубликован" : "Скрыт" })</span>@if (product.IsHiddenByAdmin && !string.IsNullOrWhiteSpace(product.ModerationReason)) { <p>Причина: @product.ModerationReason</p> }</td><td><div class="product-actions"><a class="text-link" asp-action="EditProduct" asp-route-id="@product.Id">Изменить ↗</a><a class="text-link danger-link" asp-action="DeleteProduct" asp-route-id="@product.Id">Удалить</a></div></td></tr> }</tbody></table></div> }
</section>
