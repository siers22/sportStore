@model List<Product>
@{ ViewData["Title"] = "Мои товары"; }
<section class="container page-space"><div class="dashboard-header"><div><div class="eyebrow">МОЙ МАГАЗИН</div><h1>Мои товары<span class="heading-dot">.</span></h1><p>Изменяйте цены, остатки и публикацию товаров.</p></div><a class="button button-accent" asp-action="CreateProduct">Добавить товар ↗</a></div>
    @if (Model.Count == 0) { <div class="empty-state"><h2>Пока нет товаров</h2><a class="button button-dark" asp-action="CreateProduct">Добавить первый товар</a></div> }
    else { <div class="table-wrap"><table><thead><tr><th>Товар</th><th>Категория</th><th>Цена</th><th>Остаток</th><th>Статус</th><th></th></tr></thead><tbody>@foreach (var product in Model) { <tr><td><strong>@product.Name</strong></td><td>@product.Category.Name</td><td>@product.Price.ToString("N0") ₽</td><td>@product.Stock</td><td><span class="status">@(product.IsHiddenByAdmin ? "Скрыт администратором" : product.IsPublished ? "Опубликован" : "Скрыт")</span></td><td><a class="text-link" asp-action="EditProduct" asp-route-id="@product.Id">Изменить ↗</a></td></tr> }</tbody></table></div> }
</section>
