@model List<Purchase>
@{ ViewData["Title"] = "Мои заказы"; }
<section class="container page-space"><div class="page-heading"><div class="eyebrow">ИСТОРИЯ ПОКУПОК</div><h1>Мои заказы<span class="heading-dot">.</span></h1><p>Все покупки и их статусы в одном месте.</p></div>
    @if (Model.Count == 0) { <div class="empty-state"><h2>Заказов пока нет</h2><a class="button button-dark" asp-controller="Catalog" asp-action="Index">Начать покупки ↗</a></div> }
    else { <div class="list-panel">@foreach (var purchase in Model) { <a class="list-row" asp-action="Details" asp-route-id="@purchase.Id"><div><small>ПОКУПКА №@purchase.Id · @purchase.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")</small><strong>@purchase.SellerOrders.Count заказ(ов) продавцам</strong></div><span>@purchase.Total.ToString("N0") ₽</span><b>↗</b></a> }</div> }
</section>
